# FlatMate environment configuration — PostgreSQL

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Option A — used automatically if set (this is what Render provides
# for its managed Postgres, and what you'd use for any other hosted
# Postgres too):
# DATABASE_URL=postgres://user:password@host:5432/dbname
#
# Option B — discrete variables, used when DATABASE_URL is not set.
# This is what a local install (pgAdmin / postgres.app / the official
# installer) gives you by default.
PGHOST=localhost
PGPORT=5432
PGDATABASE=flatmatedb
PGUSER=postgres
PGPASSWORD=your-postgres-password

# Force SSL on/off. Leave unset to auto-detect (on for anything that
# isn't localhost, off for localhost). Render's Postgres requires SSL,
# so this is usually left unset and it "just works" in both places.
# DB_SSL=true

# ------------------------------------------------------------
# SESSION
# ------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# CROSS-ORIGIN (only needed once Frontend and Backend are on
# different domains, e.g. Vercel + Render)
# ------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API
# with credentials (cookies). Example:
# FRONTEND_URL=https://flatmate.vercel.app,https://flatmate-git-main-you.vercel.app

# Public URL used in owner emails
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# GMAIL SMTP (use a Gmail App Password, not your normal password)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=jomecmsduirglibz
MAIL_FROM="FlatMate <your-email@gmail.com>"
MAIL_TO=your-email@gmail.com
